#!/bin/bash
apt-get update -y
apt-get install -y nginx
INTERNA=$(curl -s -H "Metadata-Flavor: Google" \
  http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/ip)

cat > /var/www/html/local.html <<HTML
<h1>Scharid - Practica 3</h1>
<p>Servidor de aplicacion. IP interna: $INTERNA</p>
HTML

cat > /etc/nginx/sites-available/default <<'CONF'
server {
    listen 80 default_server;
    root /var/www/html;

    location = /local.html { }

    location / {
        proxy_pass http://${ip_datos}:8080/;
        proxy_connect_timeout 3s;
    }
}
CONF

systemctl restart nginx